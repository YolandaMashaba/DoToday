<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/colorSurface"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/tv_dialog_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/task_new_schedule"
        android:textColor="?attr/colorOnSurface"
        android:textSize="20sp"
        android:textStyle="bold" />

    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:hint="@string/task_title_hint"
        android:textColorHint="?attr/colorOnSurfaceVariant"
        app:boxBackgroundColor="?attr/colorSurfaceContainer"
        app:hintTextColor="@color/app_secondary"
        app:boxStrokeColor="@color/app_secondary">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_task_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="?attr/colorOnSurface"
            android:textCursorDrawable="@null" />

    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="@string/task_description_hint"
        android:textColorHint="?attr/colorOnSurfaceVariant"
        app:boxBackgroundColor="?attr/colorSurfaceContainer"
        app:hintTextColor="@color/app_secondary"
        app:boxStrokeColor="@color/app_secondary">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_task_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="?attr/colorOnSurface"
            android:textCursorDrawable="@null" />

    </com.google.android.material.textfield.TextInputLayout>

    <LinearLayout
        android:id="@+id/layout_time_duration"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_pick_time"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/task_start_time"
            android:textColor="@color/app_secondary"
            app:strokeColor="@color/app_secondary" />

        <View
            android:layout_width="8dp"
            android:layout_height="0dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_pick_end_time"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/task_end_time"
            android:textColor="@color/app_secondary"
            app:strokeColor="@color/app_secondary" />

        <View
            android:layout_width="8dp"
            android:layout_height="0dp" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="@string/task_minutes"
            android:textColorHint="?attr/colorOnSurfaceVariant"
            app:boxBackgroundColor="?attr/colorSurfaceContainer"
            app:hintTextColor="@color/app_secondary"
            app:boxStrokeColor="@color/app_secondary">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_task_duration"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:textColor="?attr/colorOnSurface"
                android:textCursorDrawable="@null"
                android:padding="8dp" />

        </com.google.android.material.textfield.TextInputLayout>

    </LinearLayout>

    <!-- Repeat Task -->
    <LinearLayout
        android:id="@+id/layout_repeat_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="vertical">

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switch_repeat_task"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/task_repeat"
            android:textColor="?attr/colorOnSurface"
            android:textSize="15sp"
            android:textStyle="bold"
            app:thumbTint="@color/app_secondary"
            app:trackTint="?attr/colorSurfaceContainer" />

        <LinearLayout
            android:id="@+id/layout_repeat_details"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:visibility="gone">

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/task_frequency"
                android:textColorHint="?attr/colorOnSurfaceVariant"
                app:boxBackgroundColor="?attr/colorSurfaceContainer"
                app:boxStrokeColor="@color/app_secondary">

                <AutoCompleteTextView
                    android:id="@+id/spinner_repeat_frequency"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none"
                    android:text="@string/task_daily"
                    android:textColor="?attr/colorOnSurface" />

            </com.google.android.material.textfield.TextInputLayout>

            <View
                android:layout_width="8dp"
                android:layout_height="0dp" />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/task_repeat_count"
                android:textColorHint="?attr/colorOnSurfaceVariant"
                app:boxBackgroundColor="?attr/colorSurfaceContainer"
                app:boxStrokeColor="@color/app_secondary">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_repeat_duration"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="number"
                    android:text="7"
                    android:textColor="?attr/colorOnSurface" />

            </com.google.android.material.textfield.TextInputLayout>

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
