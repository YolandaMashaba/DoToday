<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <!-- Time on left -->
    <TextView
        android:id="@+id/tv_time_left"
        android:layout_width="50dp"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="13sp"
        app:layout_constraintBottom_toBottomOf="@id/iv_icon_background"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/iv_icon_background"
        tools:text="08:00" />

    <!-- Top Vertical Connector Line -->
    <View
        android:id="@+id/line_top"
        android:layout_width="3dp"
        android:layout_height="0dp"
        android:background="@color/timeline_line_color"
        app:layout_constraintBottom_toTopOf="@id/iv_icon_background"
        app:layout_constraintEnd_toEndOf="@id/iv_icon_background"
        app:layout_constraintStart_toStartOf="@id/iv_icon_background"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Circular Icon Badge Node -->
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/iv_icon_background"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_marginStart="12dp"
        android:background="@color/app_secondary"
        android:padding="12dp"
        app:layout_constraintStart_toEndOf="@id/tv_time_left"
        app:layout_constraintTop_toTopOf="parent"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.DoToday.Circle" />

    <ImageView
        android:id="@+id/iv_icon"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:src="@drawable/ic_alarm"
        app:layout_constraintBottom_toBottomOf="@id/iv_icon_background"
        app:layout_constraintEnd_toEndOf="@id/iv_icon_background"
        app:layout_constraintStart_toStartOf="@id/iv_icon_background"
        app:layout_constraintTop_toTopOf="@id/iv_icon_background"
        app:tint="@color/white"
        android:contentDescription="Task Icon" />

    <!-- Bottom Vertical Connector Line -->
    <View
        android:id="@+id/line_bottom"
        android:layout_width="3dp"
        android:layout_height="0dp"
        android:background="@color/timeline_line_color"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@id/iv_icon_background"
        app:layout_constraintStart_toStartOf="@id/iv_icon_background"
        app:layout_constraintTop_toBottomOf="@id/iv_icon_background" />

    <!-- Task Info Block -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="12dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/btn_complete"
        app:layout_constraintStart_toEndOf="@id/iv_icon_background"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Time & Repeat Row -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_task_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="13sp"
                tools:text="08:00" />

            <ImageView
                android:id="@+id/iv_repeat"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginStart="4dp"
                android:src="@drawable/ic_repeat"
                app:tint="?attr/colorOnSurfaceVariant"
                android:contentDescription="Repeat Icon" />
        </LinearLayout>

        <!-- Title -->
        <TextView
            android:id="@+id/tv_task_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="?attr/colorOnSurface"
            android:textSize="18sp"
            android:textStyle="bold"
            tools:text="Rise and Shine" />

        <!-- Subtitle/Description if any -->
        <TextView
            android:id="@+id/tv_task_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="13sp"
            android:visibility="gone"
            tools:text="Morning routine" />

    </LinearLayout>

    <!-- Check Ring Button -->
    <ImageView
        android:id="@+id/btn_complete"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:src="@drawable/ic_check_ring"
        app:tint="@color/app_secondary"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:contentDescription="Complete Task" />

</androidx.constraintlayout.widget.ConstraintLayout>