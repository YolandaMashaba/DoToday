<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ======================================= -->
    <!-- INTERNET AND NETWORK PERMISSIONS        -->
    <!-- ======================================= -->

    <uses-permission
        android:name="android.permission.INTERNET" />

    <uses-permission
        android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- ======================================= -->
    <!-- NOTIFICATION PERMISSIONS                -->
    <!-- ======================================= -->

    <!-- Required for Android 13 and above -->
    <uses-permission
        android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Allows notification vibration -->
    <uses-permission
        android:name="android.permission.VIBRATE" />

    <!-- ======================================= -->
    <!-- APPLICATION CONFIGURATION               -->
    <!-- ======================================= -->

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.DoToday">

        <!-- =================================== -->
        <!-- LOGIN ACTIVITY                      -->
        <!-- =================================== -->

        <activity
            android:name=".LoginActivity"
            android:exported="true"
            android:theme="@style/Theme.DoToday">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category
                    android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <!-- =================================== -->
        <!-- REGISTRATION ACTIVITY               -->
        <!-- =================================== -->

        <activity
            android:name=".RegisterActivity"
            android:exported="false"
            android:theme="@style/Theme.DoToday" />

        <!-- =================================== -->
        <!-- MAIN DASHBOARD ACTIVITY             -->
        <!-- =================================== -->

        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:theme="@style/Theme.DoToday" />

        <!-- =================================== -->
        <!-- SETTINGS ACTIVITY                   -->
        <!-- =================================== -->

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:theme="@style/Theme.DoToday" />

        <!-- =================================== -->
        <!-- FIREBASE CLOUD MESSAGING            -->
        <!-- =================================== -->

        <service
            android:name=".DoTodayMessagingService"
            android:enabled="true"
            android:exported="false">

            <intent-filter>
                <action
                    android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>

        </service>

        <!-- =================================== -->
        <!-- LOCAL TASK REMINDER RECEIVER        -->
        <!-- =================================== -->

        <receiver
            android:name=".TaskReminderReceiver"
            android:enabled="true"
            android:exported="false" />

        <!-- =================================== -->
        <!-- MULTI-LANGUAGE SUPPORT              -->
        <!-- =================================== -->

        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">

            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />

        </service>

    </application>

</manifest>